{
  "name": "pi-ter",
  "version": "0.1.0",
  "description": "Pi experimentation plugin package for custom extensions, skills, and prompts",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "main": "extensions/index.ts",
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^20.0.0",
    "@xterm/headless": "^5.5.0",
    "typebox": "^1.3.7",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "start": "pi --tui-mode fullscreen -e ."
  }
}
